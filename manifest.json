{
    "manifest_version": 3,
    "name": "Apts.com Balances",
    "description": "Summarizes past-due rent balances for all rentals on the Payments page of Apts.com.",
    "version": "1.0",
    "icons": {
        "16": "16x16.png",
        "32": "32x32.png",
        "48": "48x48.png",
        "128": "128x128.png"
    },
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["https://*.apartments.com/*"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Extract balances"
    }
}